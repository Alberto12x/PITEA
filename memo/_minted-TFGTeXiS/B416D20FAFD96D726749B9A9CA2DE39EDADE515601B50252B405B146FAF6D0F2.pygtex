\begin{Verbatim}[commandchars=\\\{\}]
\PYG{k}{[persistente]}
\PYG{c+c1}{\PYGZsh{} Contador utilizado para distinguir la caché entre varias ejecuciones en un mismo minuto}
\PYG{n}{contador\PYGZus{}cache}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}

\PYG{c+c1}{\PYGZsh{} Fecha de la última ejecución, usada para saber si es necesario utilizar el contador de caché}
\PYG{n}{ult\PYGZus{}fecha}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{}20\PYGZhy{}02\PYGZhy{}2025\PYGZus{}21:22\PYGZdq{}}

\PYG{k}{[Ajustes\PYGZus{}sstv]}
\PYG{c+c1}{\PYGZsh{} Modo de transmisión SSTV seleccionado, especifica el tipo de imagen que se usará}
\PYG{n}{modo\PYGZus{}sstv}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{}MartinM1\PYGZdq{}}

\PYG{c+c1}{\PYGZsh{} Muestras por segundo, define la calidad de la transmisión en términos de frecuencia}
\PYG{n}{samples\PYGZus{}per\PYGZus{}sec}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{48000}

\PYG{c+c1}{\PYGZsh{} Número de bits por muestra, determina la resolución de las muestras de audio}
\PYG{n}{bits}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{16}

\PYG{k}{[Ajustes\PYGZus{}ocultador\PYGZus{}imagen\PYGZus{}text]}
\PYG{c+c1}{\PYGZsh{} Tamaño de la fuente en píxeles, utilizado para ajustar el texto sobre las imágenes}
\PYG{n}{tamanio\PYGZus{}fuente}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{10}

\PYG{c+c1}{\PYGZsh{} Ancho máximo de las imágenes, para asegurarse de que las imágenes no sean demasiado anchas}
\PYG{n}{anchura\PYGZus{}maxima}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{800}

\PYG{c+c1}{\PYGZsh{} Ruta relativa a la fuente utilizada para el texto (debe estar en el directorio adecuado)}
\PYG{n}{ruta\PYGZus{}fuente}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{}../fuentes/ocraregular.ttf\PYGZdq{}}

\PYG{c+c1}{\PYGZsh{} Configuración para usar la GPU, puede ser un valor booleano (True o False)}
\PYG{n}{gpu}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{}True\PYGZdq{}}
\end{Verbatim}
